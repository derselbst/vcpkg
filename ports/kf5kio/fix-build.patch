From: "Moebert, Tom" <tom.moebert@zeiss.com>
Date: Tue, 21 Jun 2022 00:13:59 +0200
Subject: [PATCH] Fix build

---
 CMakeLists.txt                                |  2 +-
 src/core/kcoredirlister.h                     |  1 +
 .../kstatusbarofflineindicator.cpp            |  2 +-
 src/filewidgets/kstatusbarofflineindicator.h  |  2 +-
 src/ioslaves/file/file_win.cpp                | 28 +++++++++----------
 src/ioslaves/trash/kio_trash_win.cpp          |  3 +-
 src/widgets/krun.cpp                          |  1 -
 7 files changed, 19 insertions(+), 20 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index fb97c4875..a4537ad7c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -106,7 +106,7 @@ endif()
 
 set(_qt6_core_compat_found FALSE)
 if (QT_MAJOR_VERSION STREQUAL "6")
-    find_package(Qt6Core5Compat ${REQUIRED_QT_VERSION} REQUIRED) # QTextCodec
+    find_package(Qt6Core5Compat ${REQUIRED_QT_VERSION} REQUIRED) # QTextCodec QRegExp
     set(_qt6_core_compat_found ${Qt6Core5Compat_FOUND})
 endif()
 
diff --git a/src/core/kcoredirlister.h b/src/core/kcoredirlister.h
index 930b2b2e0..49dd85f62 100644
--- a/src/core/kcoredirlister.h
+++ b/src/core/kcoredirlister.h
@@ -15,6 +15,7 @@
 #include <QString>
 #include <QStringList>
 #include <QUrl>
